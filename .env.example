# ─────────────────────────────────────────────────
# ContractFlow — Required Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────

# Supabase / PostgreSQL connection string
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# App user credentials (use bcrypt hashes in production!)
# Generate hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your_password', 12))"
OWNER_USERNAME=owner
OWNER_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
# Or legacy plaintext fallback (not recommended for production):
# OWNER_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

ASSISTANT_USERNAME=assistant
ASSISTANT_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
# ASSISTANT_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Supabase SSL CA certificate pinning (recommended for production)
# Download from Supabase Dashboard -> Database -> SSL Configuration
# SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
# Or place supabase-ca.crt in the project root.

# JWT-equivalent signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=CHANGE_ME_GENERATE_RANDOM_32_BYTES

# CORS allowed origins (comma-separated, e.g. https://yourapp.vercel.app)
# Leave blank during local development only.
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────
# Google Drive Integration for Expense Receipts (Optional)
# Images are compressed, renamed (<description>_<date>.jpg),
# uploaded into separate Google Drive folders per site, and their URLs saved to the database.
#
# Option A: Google Cloud Service Account (Recommended for production/server-to-server)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=contractflow-drive@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# GOOGLE_DRIVE_ROOT_FOLDER_ID=your_parent_folder_id_here
#
# Option B: Google Apps Script Web App (Simplest 1-minute setup for personal @gmail.com)
# GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
#
# Note: If not set, photos are safely saved locally to public/uploads/ and will never block expense creation.
# ─────────────────────────────────────────────────
